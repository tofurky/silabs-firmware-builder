id: router_dlk_override
label: Router DLK Override
package: custom
description: >
  Wraps slxi_zigbee_stack_gu_zdo_dlk_override_supported_params so the
  router advertises well-known key (bit 7) in its supported secrets
  bitmask, allowing Zigbee 4.0 DLK negotiation to proceed.
category: Zigbee|Router
quality: production
source:
  - path: src/router_dlk_override.c
provides:
  - name: router_dlk_override
requires:
  - name: zigbee_dynamic_commissioning
  - name: zigbee_debug_print
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=slxi_zigbee_stack_gu_zdo_dlk_override_supported_params"
  - option: llvm_linker_option
    value: "-Wl,--wrap=slxi_zigbee_stack_gu_zdo_dlk_override_supported_params"

metadata:
  nabucasa:
    wrap_definitions:
      slxi_zigbee_stack_gu_zdo_dlk_override_supported_params: "libzigbee-dynamic-commissioning.a:sl_zigbee_zdo_dlk_negotiation.c.obj"
